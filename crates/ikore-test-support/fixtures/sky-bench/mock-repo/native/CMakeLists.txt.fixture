cmake_minimum_required(VERSION 3.15)
project(parcel C)
set(CMAKE_C_STANDARD 11)
enable_testing()
add_executable(intake_test intake_test.c intake.c)
add_test(NAME intake COMMAND intake_test)
add_executable(weighing_test weighing_test.c weighing.c)
add_test(NAME weighing COMMAND weighing_test)
add_executable(sorting_test sorting_test.c sorting.c)
add_test(NAME sorting COMMAND sorting_test)
add_executable(packing_test packing_test.c packing.c)
add_test(NAME packing COMMAND packing_test)
add_executable(dispatch_test dispatch_test.c dispatch.c)
add_test(NAME dispatch COMMAND dispatch_test)
add_executable(tracking_test tracking_test.c tracking.c)
add_test(NAME tracking COMMAND tracking_test)
add_executable(customs_test customs_test.c customs.c)
add_test(NAME customs COMMAND customs_test)
add_executable(delivery_test delivery_test.c delivery.c)
add_test(NAME delivery COMMAND delivery_test)
add_executable(returns_test returns_test.c returns.c)
add_test(NAME returns COMMAND returns_test)
add_executable(claims_test claims_test.c claims.c)
add_test(NAME claims COMMAND claims_test)
add_executable(billing_test billing_test.c billing.c)
add_test(NAME billing COMMAND billing_test)
add_executable(remittance_test remittance_test.c remittance.c)
add_test(NAME remittance COMMAND remittance_test)
