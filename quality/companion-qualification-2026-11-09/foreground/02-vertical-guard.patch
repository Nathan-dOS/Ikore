+    #[crate::test]
+    fn vertical_envelope_falls_back_for_non_finite_or_invalid_heights(cx: &mut TestAppContext) {
+        cx.update(|cx| {
+            let id = FontId(710_005);
+            vertical_font_height(cx,id,8.0);
+            let layout = synthetic_line(id);
+            let mask = Bounds::new(point(px(0.0),px(100.0)),size(px(500.0),px(20.0)));
+            for origin in [f32::NAN,f32::INFINITY,f32::NEG_INFINITY] {
+                assert!(!glyphs_outside_vertical_mask(px(origin),&layout,px(24.0),0,&mask,cx.text_system()));
+            }
+            for height in [f32::NAN,f32::INFINITY,f32::NEG_INFINITY] {
+                assert!(!glyphs_outside_vertical_mask(px(450.0),&layout,px(height),1,&mask,cx.text_system()));
+            }
+            for (mask_top,mask_height) in [(f32::NAN,20.0),(100.0,f32::INFINITY),(100.0,-20.0)] {
+                let invalid_mask = Bounds::new(point(px(0.0),px(mask_top)),size(px(500.0),px(mask_height)));
+                assert!(!glyphs_outside_vertical_mask(px(450.0),&layout,px(24.0),0,&invalid_mask,cx.text_system()));
+            }
+            for font_height in [f32::NAN,f32::INFINITY,-8.0] {
+                vertical_font_height(cx,id,font_height);
+                assert!(!glyphs_outside_vertical_mask(px(450.0),&layout,px(24.0),0,&mask,cx.text_system()));
+            }
+            vertical_font_height(cx,id,8.0);
+            assert!(!glyphs_outside_vertical_mask(px(f32::MAX),&layout,px(f32::MAX),2,&mask,cx.text_system()));
