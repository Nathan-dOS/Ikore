+            underline.underline = Some(UnderlineStyle {thickness:px(0.0),color:Some(Hsla::transparent_black()),wavy:false});
+            let mut strike = decoration(None);
+            strike.strikethrough = Some(StrikethroughStyle {thickness:px(0.0),color:Some(Hsla::transparent_black())});
+            let mut zero_len = underline.clone();
