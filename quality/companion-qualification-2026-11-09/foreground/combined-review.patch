+    #[crate::test]
+    fn vertical_culling_skips_plain_visits_preserving_empty_layers_and_replay(cx: &mut TestAppContext) {
+        paint_in_window(cx, |window, cx| {
+            let font_id = FontId(710_000);
+            vertical_font_height(cx, font_id, 8.0);
+            let layout = synthetic_line(font_id);
+            let mask = Bounds::new(point(px(0.0),px(100.0)),size(px(500.0),px(10.0)));
+            // line_bounds spans 40..140, but every glyph guard spans only 40..48.
+            let colored_bounds = Bounds::new(point(px(40.0),px(100.0)),size(px(10.0),px(10.0)));
+            window.with_content_mask(Some(crate::ContentMask {bounds:mask}), |window| {
+                window.paint_layer(colored_bounds, |window| window.paint_quad(fill(colored_bounds,rgb(0xaa3344))));
+            });
+            let start = window.next_frame.scene.len();
+            assert_eq!(vertical_visits((point(px(40.0),px(40.0)),px(100.0)),&layout,&[decoration(None)],&[],mask,window,cx),0);
+            assert_eq!(window.next_frame.scene.len(),start+2,"empty layer must survive the skip");
+            assert!(matches!(window.next_frame.scene.paint_operations[start],PaintOperation::StartLayer(_)));
+            assert!(matches!(window.next_frame.scene.paint_operations[start+1],PaintOperation::EndLayer));
+            window.with_content_mask(Some(crate::ContentMask {bounds:mask}), |window| {
+                window.paint_layer(colored_bounds, |window| window.paint_quad(fill(colored_bounds,rgb(0x3355aa))));
+            });
+            let source = &window.next_frame.scene;
+            let mut replay = Scene::default();
+            replay.replay(0..source.len(),source);
+            replay.finish();
+            assert_eq!(operation_kinds(&replay),operation_kinds(source));
+            assert_eq!(replay.quads.len(),source.quads.len());
+            for (actual,expected) in replay.quads.iter().zip(&source.quads) {
+                assert_eq!((actual.order,actual.bounds,actual.background),(expected.order,expected.bounds,expected.background));
+            }
+            assert!(source.quads[source.quads.len()-2].order < source.quads.last().unwrap().order);
+            let last_order = replay.quads.last().unwrap().order;
+            replay.insert_primitive(source.quads.last().unwrap().clone());
+            assert!(replay.quads.last().unwrap().order > last_order,"layer stack must remain balanced");
+        });
+    }
