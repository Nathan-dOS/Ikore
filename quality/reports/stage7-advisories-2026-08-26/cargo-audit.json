erences":[],"source":null,"url":"https://github.com/harfbuzz/ttf-parser/issues/217","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"affected":null,"versions":{"patched":[],"unaffected":[]}}],"unsound":[{"kind":"unsound","package":{"name":"git2","version":"0.20.4","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"7b88256088d75a56f8ecfa070513a775dd9107f6530ef14919dac831af9cfe2b","dependencies":[{"name":"bitflags","version":"2.13.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"libc","version":"0.2.189","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"libgit2-sys","version":"0.18.8+1.9.7","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"log","version":"0.4.34","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"url","version":"2.5.8","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null},"advisory":{"id":"RUSTSEC-2026-0183","package":"git2","title":"Potential undefined behavior when calling Remote::list()","description":"When calling `Remote::list()` for a remote of a git repository, when that remote does not advertise any references, git2 passes a null pointer to the unsafe function `slice::from_raw_parts()`. Based on the safety section documentation of function, data must be non-null even for slices of length zero. Thus, the use of a null pointer leads to undefined behavior.","date":"2026-05-12","aliases":[],"related":[],"collection":"crates","categories":[],"keywords":["git2"],"cvss":null,"informational":"unsound","references":[],"source":null,"url":"https://github.com/rust-lang/git2-rs/pull/1250","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"affected":null,"versions":{"patched":[">=0.21.0"],"unaffected":[]}},{"kind":"unsound","package":{"name":"git2","version":"0.20.4","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"7b88256088d75a56f8ecfa070513a775dd9107f6530ef14919dac831af9cfe2b","dependencies":[{"name":"bitflags","version":"2.13.1","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"libc","version":"0.2.189","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"libgit2-sys","version":"0.18.8+1.9.7","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"log","version":"0.4.34","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"url","version":"2.5.8","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null},"advisory":{"id":"RUSTSEC-2026-0184","package":"git2","title":"Potential undefined behavior with Signature from a buffer-created BlameHunk","description":"When a `Blame` is created via `Blame::blame_buffer()`, and a `BlameHunk` is retrieved, the pointers to the original author, original committer, final author, and final committer may be null if unavailable. The corresponding `BlameHunk` methods then create `Signature`s based on null pointers; attempting to access the data of the `Signature`s leads to dereferencing null pointers.","date":"2026-05-13","aliases":[],"related":[],"collection":"crates","categories":[],"keywords":["git2"],"cvss":null,"informational":"unsound","references":[],"source":null,"url":"https://github.com/rust-lang/git2-rs/pull/1254","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"affected":null,"versions":{"patched":[">=0.21.0"],"unaffected":[]}}]}}

