diff --git a/third_party/gpui/src/hvc_frame_trace.rs b/third_party/gpui/src/hvc_frame_trace.rs
new file mode 100644
--- /dev/null
+++ b/third_party/gpui/src/hvc_frame_trace.rs
@@ -0,0 +1,88 @@
+//! Temporary debug-only rendering diagnostics. Removed after the diagnostic run.
+#![allow(missing_docs)]
+
+use std::{cell::RefCell, collections::{BTreeMap, HashSet}, path::PathBuf, sync::{Mutex, OnceLock,atomic::{AtomicBool,Ordering}}, time::{Instant, SystemTime, UNIX_EPOCH}};
+use serde::Serialize;
+use serde_json::{Value, json};
+
+static COMPLETE: AtomicBool = AtomicBool::new(false);
+const MAX_FRAMES:usize=2048;
+const MAX_EVENTS:usize=2048;
+const MAX_LAYOUT_TAGS:usize=16384;
+pub fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("HVC_DIAGNOSTIC_TRACE").is_some()) && !COMPLETE.load(Ordering::Relaxed)
+}
+fn epoch_ns() -> u64 { SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos() as u64 }
+static EVENTS: Mutex<Vec<Value>> = Mutex::new(Vec::new());
+pub fn event(label: &'static str) {
+    if enabled() { let mut events=EVENTS.lock().unwrap();if events.len()<MAX_EVENTS {events.push(json!({"label":label,"epochNs":epoch_ns()}));} }
+}
+#[derive(Default, Serialize)]
+struct Measures {
+    calls:u64, hits:u64, cold:u64, wrap_changed:u64, truncate_changed:u64, other_miss:u64,
+    hit_none:u64, hit_some:u64, miss_none:u64, miss_some:u64,
+    none_to_some:u64, some_to_none:u64, some_to_other:u64, bytes:u64,
+    paint_calls:u64, paint_outside_mask:u64,
+}
+impl Measures {
+    fn measure(&mut self, old:Option<(Option<f32>,Option<f32>)>, wrap:Option<f32>, truncate:Option<f32>, hit:bool, bytes:usize) {
+        self.calls+=1; self.bytes+=bytes as u64;
+        if hit { self.hits+=1; if wrap.is_none(){self.hit_none+=1}else{self.hit_some+=1}; return; }
+        if wrap.is_none(){self.miss_none+=1}else{self.miss_some+=1};
+        match old {
+            None=>self.cold+=1,
+            Some((old_wrap,old_truncate))=> {
+                if old_wrap!=wrap { self.wrap_changed+=1; match(old_wrap,wrap){(None,Some(_))=>self.none_to_some+=1,(Some(_),None)=>self.some_to_none+=1,(Some(_),Some(_))=>self.some_to_other+=1,_=>{}} }
+                else if old_truncate!=truncate {self.truncate_changed+=1} else {self.other_miss+=1}
+            }
+        }
+    }
+}
+#[derive(Default, Serialize)]
+struct Frame {
+    index:u64, epoch_ns:u64, interval_ns:u64, fixture_frame:Option<u64>, fixture_updates:usize,
+    hydrating:bool, quota_loading:bool, counts:BTreeMap<&'static str,u64>, scope_ns:BTreeMap<&'static str,u64>,
+    all:Measures, message:Measures,
+}
+struct Trace {
+    path:PathBuf, frames:Vec<Frame>, current:Frame, tagged:HashSet<usize>, previous:Option<Instant>, finish:bool, terminal:Value,
+}
+thread_local! { static TRACE: RefCell<Option<Trace>> = const {RefCell::new(None)}; }
+fn with_trace(f:impl FnOnce(&mut Trace)) {
+    if !enabled(){return;}
+    TRACE.with_borrow_mut(|slot| {
+        let trace=slot.get_or_insert_with(|| Trace{path:std::env::var_os("HVC_DIAGNOSTIC_TRACE").unwrap().into(),frames:Vec::with_capacity(145),current:Frame::default(),tagged:HashSet::with_capacity(512),previous:None,finish:false,terminal:Value::Null});
+        f(trace)
+    });
+}
+pub fn begin_frame() {
+    with_trace(|s| {
+        let now=Instant::now();
+        s.current=Frame{index:s.frames.len() as u64,epoch_ns:epoch_ns(),interval_ns:s.previous.map_or(0,|p|now.duration_since(p).as_nanos() as u64),..Frame::default()};
+        s.previous=Some(now); s.tagged.clear();
+    });
+}
+pub fn end_frame() { with_trace(|s| {if s.frames.len()<MAX_FRAMES{s.frames.push(std::mem::take(&mut s.current));}else{s.finish=true;}}); }
+pub fn mark_fixture(frame:u64,updates:usize) {with_trace(|s| {s.current.fixture_frame=Some(frame);s.current.fixture_updates=updates;});}
+pub fn flags(hydrating:bool,quota_loading:bool){with_trace(|s|{s.current.hydrating=hydrating;s.current.quota_loading=quota_loading;});}
+pub fn mark_layout(id:usize){with_trace(|s|{if s.tagged.len()<MAX_LAYOUT_TAGS{s.tagged.insert(id);}});}
+pub fn count(label:&'static str, amount:u64){with_trace(|s|{*s.current.counts.entry(label).or_default()+=amount;});}
+pub fn measure(id:usize,old:Option<(Option<f32>,Option<f32>)>,wrap:Option<f32>,truncate:Option<f32>,hit:bool,bytes:usize){
+    with_trace(|s|{s.current.all.measure(old,wrap,truncate,hit,bytes);if s.tagged.contains(&id){s.current.message.measure(old,wrap,truncate,hit,bytes);}});
+}
+pub fn paint(id:usize,outside:bool){with_trace(|s|{s.current.all.paint_calls+=1;s.current.all.paint_outside_mask+=u64::from(outside);if s.tagged.contains(&id){s.current.message.paint_calls+=1;s.current.message.paint_outside_mask+=u64::from(outside);}});}
+pub struct Scope(Option<(Instant,&'static str)>);
+pub fn scope(label:&'static str)->Scope {Scope(enabled().then(||(Instant::now(),label)))}
+impl Drop for Scope {fn drop(&mut self){if let Some((start,label))=self.0 {with_trace(|s|{*s.current.scope_ns.entry(label).or_default()+=start.elapsed().as_nanos() as u64;});}}}
+pub fn finish_after_present(terminal:Value){with_trace(|s|{s.finish=true;s.terminal=terminal;});}
+pub fn finish_present(ns:u64){with_trace(|s| {
+    if let Some(last)=s.frames.last_mut(){last.scope_ns.insert("present",ns);}
+    if s.finish {
